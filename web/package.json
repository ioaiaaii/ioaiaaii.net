{
  "name": "web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "vite build && start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0 && prettier --check src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "vue": "^3.5.39",
    "vue-router": "^5.3.1"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.1",
    "cypress": "^16.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.8.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.2.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
