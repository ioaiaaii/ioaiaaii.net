# frame-src: the only third-party frames are the players on Works (Bandcamp for a
# release, SoundCloud for a work), and each loads only when its Listen is clicked.
# Cross-Origin-Opener-Policy keeps any window this site opens (and any page that opens
# it) out of its browsing context; Cross-Origin-Resource-Policy keeps other sites from
# embedding its files. The players are frames from their own origins, so neither
# applies to them.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://bandcamp.com https://w.soundcloud.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

# The site's address is https://ioannissavvaidis.com. Keep the project's own pages.dev
# host out of search results, so it never competes with it. (Preview deployments get
# this header from Pages already.)
https://ioaiaaii-net.pages.dev/*
  X-Robots-Tag: noindex

# Fingerprinted assets are immutable — cache hard. Everything else, the HTML
# included, keeps Pages' default (public, max-age=0, must-revalidate), so a new deploy
# shows at once. Routes need no _redirects: with no 404.html in the build, Pages
# serves index.html for any path that isn't a file, which is what this SPA needs.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
